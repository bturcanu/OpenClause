# ─── Database ───────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=openclause
POSTGRES_PASSWORD=changeme
POSTGRES_DB=openclause
# Use 'require' for production; 'disable' only for local dev (logged as WARN).
POSTGRES_SSLMODE=disable
POSTGRES_POOL_MAX_CONNS=20

# ─── OPA ────────────────────────────────────────────────────────────
OPA_URL=http://localhost:8181

# ─── Services ───────────────────────────────────────────────────────
GATEWAY_ADDR=:8080
APPROVALS_ADDR=:8081
CONNECTOR_SLACK_ADDR=:8082
CONNECTOR_JIRA_ADDR=:8083

APPROVALS_URL=http://localhost:8081
# Returned in approval_url to callers. Set to host-accessible address when
# running in Docker. Falls back to APPROVALS_URL if unset.
PUBLIC_APPROVALS_URL=http://localhost:8081
CONNECTOR_SLACK_URL=http://localhost:8082
CONNECTOR_JIRA_URL=http://localhost:8083

# ─── Auth ───────────────────────────────────────────────────────────
# Comma-separated list of tenant_id:api_key pairs for quick local dev.
# NOTE: The `tenant_id` must match the tenant IDs present in your database.
# If you created tenants via the setup wizard, ids are typically UUIDs (not
# `tenant1`), so update API_KEYS accordingly.
#
# Even env-based keys respect the tenant's status in the DB. If a tenant is
# set to "disabled" via the console-api, gateway will reject requests for that
# tenant regardless of this env var. For production, prefer DB-backed keys
# created via the console-api.
API_KEYS=tenant1:sk-test-key-1,tenant2:sk-test-key-2

# ─── Connectors ─────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-test-token
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-token

# ─── Internal Auth (shared secret for service-to-service calls) ────
# REQUIRED — approvals service will refuse to start without this.
INTERNAL_AUTH_TOKEN=change-me-to-a-random-secret

# ─── Approver Auth (minimal RBAC allowlists) ────────────────────────
# Format: tenant_id:value1|value2,tenant2:value3
ALLOWLIST_SOURCE=db
# `db` (default): DB-backed approver roles via users + user_roles (role='approver')
# `env`: dev-only fallback via APPROVER_EMAIL_ALLOWLIST / APPROVER_SLACK_ALLOWLIST
# `both`: allow if either DB role membership or env allowlist matches
APPROVER_EMAIL_ALLOWLIST=
APPROVER_SLACK_ALLOWLIST=

# ─── Mock mode (set to "true" to use mock connectors) ──────────────
MOCK_CONNECTORS=true

# ─── Object Storage (MinIO / S3) ───────────────────────────────────
EVIDENCE_S3_ENDPOINT=localhost:9000
EVIDENCE_S3_BUCKET=openclause-evidence
EVIDENCE_S3_ACCESS_KEY=minioadmin
EVIDENCE_S3_SECRET_KEY=minioadmin
EVIDENCE_S3_SECURE=false

# ─── Notification Dispatcher (CloudEvents webhooks) ─────────────────
APPROVALS_NOTIFIER_ENABLED=true
APPROVALS_NOTIFIER_INTERVAL_SEC=5
APPROVALS_NOTIFIER_SOURCE=oc://approvals
# Format: secret_ref=secret_value,other_ref=other_secret
WEBHOOK_SECRET_REFS=tenant1_webhook=change-me

# ─── Slack Interactive Approvals ─────────────────────────────────────
SLACK_SIGNING_SECRET=

# ─── Observability ──────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=oc-gateway
METRICS_ADDR=127.0.0.1:9090

# ─── Rate Limiting ──────────────────────────────────────────────────
RATE_LIMIT_PER_TENANT=100

# ─── Console API ──────────────────────────────────────────────────────
CONSOLE_API_ADDR=:8090
# REQUIRED — must be ≥32 bytes; server refuses to start with empty or
# the old default value. Generate with: openssl rand -hex 32
CONSOLE_JWT_SECRET=
CONSOLE_JWT_EXPIRY_HOURS=24
# Comma-separated allowed origins for CORS (empty = no CORS headers set).
# Include both Vite dev server (5173) and docker-compose console-ui (3000).
CONSOLE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── LLM Summarizer (optional) ──────────────────────────────────────
LLM_SUMMARIZER_URL=
LLM_SUMMARIZER_ENABLED=false

# ─── Archiver ────────────────────────────────────────────────────────
ARCHIVER_RUN_ONCE=true
ARCHIVER_INTERVAL_SEC=300
ARCHIVER_TENANT_ID=
